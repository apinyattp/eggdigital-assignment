# ช่องกรอกค่าในเครื่อง: ใส่ค่าจริงเฉพาะไฟล์ .env ที่ root ของ repository
# .env.example เป็นแม่แบบค่าว่าง ห้ามใส่ค่าลับหรือรหัสผ่านจริงในไฟล์นี้
# ชื่อค่าด้านล่างเป็นข้อเสนอชั่วคราว รอ SA ยืนยัน contract สุดท้าย
# ขณะนี้ยังไม่มี code/Compose ที่อ่านค่าเหล่านี้ และยังไม่มีคำสั่ง restart ที่ยืนยันแล้ว
# หลังมี implementation ให้เริ่มหรือสร้าง container ใหม่ตาม README ที่ตรวจแล้วเพื่อโหลดค่าใหม่
# ห้ามส่ง client secret ไป frontend หรือใช้ชื่อ NEXT_PUBLIC_ สำหรับค่าลับ
# ไม่ต้องกรอก provider access token, refresh token หรือรหัสผ่านผู้ใช้ด้วยตนเอง

# Google client ID เป็นตัวระบุสาธารณะ; client secret เป็นค่าลับสำหรับ backend
# การเข้าสู่ระบบ Google ไม่ได้ให้สิทธิ์ Google Calendar โดยอัตโนมัติ
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# เว้นว่างจนกว่า contract และ redirect URI จริงจะยืนยันแล้ว
GOOGLE_REDIRECT_URI=

# Zoom: ยังไม่ได้เลือกรูปแบบ OAuth; เก็บ client secret เฉพาะ backend
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# กรอกเฉพาะเมื่อรูปแบบ OAuth ที่เลือกต้องใช้ redirect URI และมี contract ยืนยันแล้ว
ZOOM_REDIRECT_URI=
# กรอกเฉพาะเมื่อยืนยันเลือก Zoom Server-to-Server OAuth; มิฉะนั้นเว้นว่าง
ZOOM_ACCOUNT_ID=
