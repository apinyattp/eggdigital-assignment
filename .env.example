# ช่องกรอกค่าในเครื่อง: ใส่ค่าจริงเฉพาะไฟล์ .env ที่ root ของ repository
# .env.example เป็นแม่แบบค่าว่าง ห้ามใส่ค่าลับหรือรหัสผ่านจริงในไฟล์นี้
# Code/Compose สำหรับ Login อ่านค่าเฉพาะที่ระบุใน README
# หลังมี implementation ให้เริ่มหรือสร้าง container ใหม่ตาม README ที่ตรวจแล้วเพื่อโหลดค่าใหม่
# Client secret ใช้ได้เฉพาะฝั่ง server; ห้ามใช้ชื่อ NEXT_PUBLIC_ สำหรับค่าลับ
# ไม่ต้องกรอก provider access token, refresh token หรือรหัสผ่านผู้ใช้ด้วยตนเอง

# Google client ID เป็นตัวระบุสาธารณะ; client secret เป็นค่าลับสำหรับ NextAuth server
# การเข้าสู่ระบบ Google ไม่ได้ให้สิทธิ์ Google Calendar โดยอัตโนมัติ
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# เว้นว่างจนกว่า contract และ redirect URI จริงจะยืนยันแล้ว
GOOGLE_REDIRECT_URI=

# Local Login runtime: backend setup:local generates private values in backend/.local.env.
# Compose explicitly maps only required keys; DATABASE_URL always targets its owned db service.
# Optional standalone BE configuration (never put actual values in this example):
PORT=3001
DATABASE_URL=
ALLOWED_ORIGIN=http://localhost:3000
JWT_SIGNING_KEY_BASE64=
JWT_ISSUER=urn:meeting-manager:local
JWT_AUDIENCE=urn:meeting-manager:api
JWT_ACCESS_TTL_SECONDS=900
COOKIE_SECURE=false
# Local PostgreSQL and synthetic fixture setup; generated in backend/.local.env, not root .env:
POSTGRES_PASSWORD=
LOGIN_FIXTURE_PASSWORD=

# Server-only NextAuth bridge: setup:bridge writes separate backend/.bridge.local.env.
# Express signing key stays backend-only. Never expose these through NEXT_PUBLIC_*.
AUTH_SERVICE_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_BACKEND_INTERNAL_URL=http://localhost:3001
